{
  "consumer": {
    "name": "ReferenceDataMfe"
  },
  "interactions": [
    {
      "description": "a request for the first page of active catalogs",
      "providerStates": [
        {
          "name": "an active Reference Data catalog exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/catalogs",
        "query": {
          "is_active": [
            "true"
          ],
          "page": [
            "1"
          ],
          "page_size": [
            "20"
          ]
        }
      },
      "response": {
        "body": {
          "data": [
            {
              "code": "DOCUMENT_TYPE",
              "created_at": "2026-01-01T00:00:00Z",
              "description": "Reference catalog for document types",
              "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
              "is_active": true,
              "name": "Document type"
            }
          ],
          "pagination": {
            "page": 1,
            "page_size": 20,
            "total_items": 1,
            "total_pages": 1
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].code": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].is_active": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pagination.total_items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pagination.total_pages": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.0.2"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "ReferenceDataService"
  }
}